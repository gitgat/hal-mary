# Secrets — never commit
.env
.env.local

# Generated from the live ESPN payload — real leaguemates' names and the league
# id. `hal-mary sync` rewrites it on every run. The tracked placeholder is
# memory/league.example.md; names in git history cannot be removed by a commit.
memory/league.md

# Data — local to each box, never in git
*.db
*.db-wal
*.db-shm
data/

# Python
__pycache__/
*.py[cod]
.venv
# No trailing slash, deliberately. `.venv/` ignores a *directory* named .venv and
# does NOT ignore a *symlink* of the same name -- a `.venv -> ...` link created to
# share one interpreter between git worktrees was swept in by `git add -A` and
# committed, and checking that branch out then replaced the real venv with a link
# to itself ("Too many levels of symbolic links" on every uv run).
.playwright-mcp/
draft-phone.png
.pytest_cache/
.ruff_cache/
*.egg-info/

# Claude call logs / scratch
scratch/
logs/

# SDD workspace (scratch)
.superpowers/

# Claude subprocess working directory (config: claude.scratch_dir)
.hal-mary-scratch/

# Per-task scratch briefs live in .superpowers/, never in the repo root
BRIEF.md

# Databases and their backups, wherever they land. The live one carries real
# leaguemates' names; a copy of it in the repo is the same disclosure with an
# extra step. One was committed on 2026-09-08 and had to be removed from
# history, which is the expensive way to learn this.
hal.db
hal.db-wal
hal.db-shm
*.db
*.db.backup-*
backups/
