# hal-mary environment. Copy to .env and fill in. .env is gitignored and never
# committed; this file carries key names and nothing else.

# ESPN session cookies, copied from a logged-in browser (DevTools > Application >
# Cookies on fantasy.espn.com). They expire — when ESPN sync starts failing
# mid-season, refresh these first.
ESPN_S2=
# The SWID cookie, braces included, e.g. <{XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}>
SWID=

# Numeric ESPN league id, from the league URL (?leagueId=...).
LEAGUE_ID=
# Caroline's team id within that league (1..team_count).
TEAM_ID=
# Season year, e.g. <2026>.
SEASON=

# Password for the local web app. Any long random string; it is the only thing
# between the app and anyone else on the network.
WEB_PASSWORD=

# Bearer token for the /mcp endpoint, which is what Claude Cowork connects to.
# Deliberately NOT the same string as WEB_PASSWORD: two doors, two keys. This
# one is reachable from the internet through the tunnel and the dashboard is
# not, so a shared credential would put Caroline's live ESPN session cookies on
# the public side. Any long random string; `openssl rand -hex 32` is fine.
#
# Leave it unset and /mcp refuses every request. Absent never means open.
MCP_TOKEN=

# Path to the SQLite file. Defaults to ./hal.db when unset. Must be on local
# disk — SQLite on an NFS mount corrupts.

# Path to the SQLite file. Leaving this empty is fine: it then defaults to
# ~/hal-mary-data/hal.db, which is where it should be — on local disk, and
# OUTSIDE the checkout, which is the directory a deploy replaces and a rollback
# moves. The nightly backups follow the database, so they land there too.
#
# Must be on local disk. SQLite on an NFS mount corrupts, and in this homelab
# /var/data is a TrueNAS export mounted on every node. `hal-mary doctor` checks
# the filesystem under this path and refuses an install onto a network mount.
#
# A RELATIVE path here is resolved against the directory holding config.toml,
# not against the working directory — the same rule as every path in
# config.toml. That means a relative value puts the database inside the
# checkout; `hal-mary doctor` reports that too. Write it absolute, or leave it
# empty and take the default.
DB_PATH=
