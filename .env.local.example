# Local, machine-specific values. NOT COMMITTED — see .gitignore.
#
# The repo's docs use documentation placeholders (example.com, 192.0.2.x) so
# nothing about one person's homelab ships in an open-source repo. This file is
# where the real values live for whoever is actually operating it.
#
#   cp .env.local.example .env.local && $EDITOR .env.local
#   source .env.local     # then use $HALMARY_SSH, $HALMARY_DASHBOARD, ...

# The box hal-mary runs on, as ssh would reach it. Use the FQDN or the IP:
# a bare short name can fall through a DNS wildcard onto a different machine.
HALMARY_SSH=you@halmary.example.com
HALMARY_IP=192.0.2.10

# The dashboard, LAN-only, behind WEB_PASSWORD.
HALMARY_DASHBOARD=https://dashboard.example.com

# The MCP endpoint, path-scoped and behind MCP_TOKEN. Reachable from outside
# so a cloud browser can use it.
HALMARY_MCP=https://mcp.example.com/mcp

# The host the reverse proxy runs on, if there is one.
HALMARY_INGRESS=you@ingress.example.com
